# ── API Key ───────────────────────────────────────────────────────────────────
# Google Gemini API key. Get one at https://aistudio.google.com/apikey
#
# Setting it here is the recommended approach for CLI use and automation.
# Alternatively you can enter the key directly in the desktop GUI at runtime —
# it will be kept in process memory only and never written to disk.
# A key entered in the GUI overrides the value set here.
GOOGLE_API_KEY=your-google-api-key-here

# ── LLM / Embedding ───────────────────────────────────────────────────────────
# Gemini model used for planning and writing. gemini-2.5-flash is the default.
# Other options: gemini-1.5-pro, gemini-1.5-flash
# LLM_MODEL=gemini-2.5-flash

# Embedding model used to build the vector store.
# EMBEDDING_MODEL=gemini-embedding-001

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of chunks retrieved per section during writing (top-K).
# RETRIEVER_K=8

# ── Workspace ─────────────────────────────────────────────────────────────────
# Root directory for all workspaces (uploads, outputs, vector DB).
# Each workspace is isolated under WORKSPACE_ROOT/<workspace_id>/
# WORKSPACE_ROOT=data
