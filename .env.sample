# ── API Keys ──────────────────────────────────────────────────────────────────
# Set the key(s) for the provider(s) you want to use.
#
# The desktop GUI can also accept keys at runtime and keeps them in process
# memory only. A key entered there overrides the value loaded from this file.
#
# Gemini
# GOOGLE_API_KEY=your-google-api-key-here
#
# OpenAI
# OPENAI_API_KEY=your-openai-api-key-here
#
# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ── LLM / Embedding ───────────────────────────────────────────────────────────
# Which provider to use for planning, chat, and writing.
# Supported values: gemini, openai, deepseek
# LLM_PROVIDER=gemini
#
# Model used for planning, chat, and writing. The valid model names depend on
# the chosen provider. Defaults to gemini-2.5-flash.
# LLM_MODEL=gemini-2.5-flash

# ── Embeddings ────────────────────────────────────────────────────────────────
# Embedding provider for document retrieval:
#   gemini  -> GoogleGenerativeAIEmbeddings (needs GOOGLE_API_KEY)
#   openai  -> OpenAIEmbeddings             (needs OPENAI_API_KEY)
#   local   -> sentence-transformers model  (free, no key needed)
# EMBEDDING_PROVIDER=gemini
#
# Cloud embedding model (used when EMBEDDING_PROVIDER=gemini)
# EMBEDDING_MODEL=gemini-embedding-001
#
# Local HuggingFace model (used when EMBEDDING_PROVIDER=local)
# LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of chunks retrieved per section during writing (top-K).
# RETRIEVER_K=8

# ── Workspace ─────────────────────────────────────────────────────────────────
# There is no WORKSPACE_ROOT setting anymore.
#
# CLI / API workspaces resolve to <app_data_dir>/<workspace_id>/.
# The app data dir defaults to ~/.uacragent and can be changed from the
# desktop GUI's global app settings dialog.
#
# The desktop GUI can also use a user-selected workspace folder for a session,
# but that choice is committed on first Load Session and then treated as fixed.
#
# Auto-created GUI workspaces live under <app_data_dir>/sessions/.
# Local embedding models are cached under <app_data_dir>/models/.

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Sections are written sequentially (one at a time) to avoid overloading the API.

# Seconds to wait after each completed LLM call before starting the next one.
# Increase this if you still see 503 / 429 errors (default: 3.0).
# LLM_REQUEST_DELAY=3.0

# Maximum retry attempts on transient 503 / 429 / quota errors.
# Keep this low — retrying a rate-limited API creates even more requests (default: 2).
# LLM_MAX_RETRIES=2

# Initial backoff delay in seconds before the first retry.
# Doubles each attempt and is capped at 60 s (default: 10.0).
# LLM_RETRY_BASE_DELAY=10.0
