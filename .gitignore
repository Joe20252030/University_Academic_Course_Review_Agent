# ===============================
# Python
# ===============================
# Byte-compiled / optimized / DLL files (ignore everywhere)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
**/.pytest_cache/

# ===============================
# Virtual environments
# ===============================
.venv/
venv/

# ===============================
# Secrets
# ===============================
.env

# ===============================
# OS / Editor
# ===============================
.DS_Store
.vscode/
.idea/

# ===============================
# Project-generated data
# ===============================
data/default/

# Optional: ignore PDFs / generated docs
# *.pdf
# *.docx

# ===============================
# Draft files
# ===============================
drafts/